# devnet or mainnet
NEXT_PUBLIC_CLUSTER=devnet
# Server-side RPC the /api/rpc route forwards to (keeps the provider key out of the browser),
# for example https://devnet.helius-rpc.com/?api-key=...
SOLANA_RPC_URL=
# Optional: more RPC URLs (comma-separated) to fall over to when that one fails; the cluster's
# public endpoint is always the last resort
# SOLANA_RPC_FALLBACK_URLS=
# Optional: make the browser call an RPC directly instead of /api/rpc. Everything NEXT_PUBLIC_ is
# built into the pages every visitor downloads: never put a URL with an API key here.
# NEXT_PUBLIC_RPC=
# Optional: the launchpad account the app lists problems for, per cluster. Defaults to the
# cluster's entry in LAUNCHPADS (src/lib/config.ts); a build with neither refuses to start.
# NEXT_PUBLIC_DEVNET_LAUNCHPAD=
# NEXT_PUBLIC_MAINNET_LAUNCHPAD=
# Optional: the DBC config launches use, per cluster. Defaults to the cluster's entry in DBC_CONFIGS
# (src/lib/config.ts)
# NEXT_PUBLIC_DEVNET_DBC_CONFIG=
# NEXT_PUBLIC_MAINNET_DBC_CONFIG=
# Optional: the public URL used for page metadata and the sitemap; defaults to https://meteortoll.vercel.app
# NEXT_PUBLIC_SITE_URL=
# Local testing only (localhost, never mainnet): offer a burner wallet kept in browser storage
# NEXT_PUBLIC_DEV_BURNER=1
