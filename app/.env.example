# devnet or mainnet
NEXT_PUBLIC_CLUSTER=devnet
# Server-side RPC the /api/rpc route forwards to (keeps the provider key out of the browser),
# for example https://devnet.helius-rpc.com/?api-key=...
SOLANA_RPC_URL=
# Optional: make the browser call an RPC directly instead of /api/rpc
# NEXT_PUBLIC_RPC=
# Optional: the launchpad account the app lists problems for, per cluster. Defaults to the
# cluster's entry in LAUNCHPADS (src/lib/config.ts); a build with neither refuses to start.
# NEXT_PUBLIC_DEVNET_LAUNCHPAD=
# NEXT_PUBLIC_MAINNET_LAUNCHPAD=
# Local testing only: offer a throwaway burner wallet
# NEXT_PUBLIC_DEV_BURNER=1
